<?xml version="1.0"?>
<robot name="drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================
       Base drone body
       ========================= -->
  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.02"
        ixy="0.0"
        ixz="0.0"
        iyy="0.02"
        iyz="0.0"
        izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.15"/>
      </geometry>
      <material name="black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.6 0.6 0.15"/>
      </geometry>
    </collision>

    <!-- Keep the drone floating for this first spawn stage -->
    <gazebo>
      <gravity>false</gravity>
    </gazebo>

  </link>


  <!-- =========================
       Arm 1
       ========================= -->
  <link name="arm_front">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.2 0.08 0.08"/>
      </geometry>
      <material name="dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="arm_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_front"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>


  <!-- =========================
       Arm 2
       ========================= -->
  <link name="arm_side">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.08 1.2 0.08"/>
      </geometry>
      <material name="dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="arm_side_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_side"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- =========================
       Rotor helper macro
       ========================= -->
  <xacro:macro name="rotor" params="name x y">

    <link name="${name}">

      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.13" length="0.025"/>
        </geometry>
        <material name="rotor_material">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>
      </visual>

    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.08" rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- Four rotors -->
  <xacro:rotor name="rotor_front_left"  x="0.45"  y="0.45"/>
  <xacro:rotor name="rotor_front_right" x="0.45"  y="-0.45"/>
  <xacro:rotor name="rotor_rear_left"   x="-0.45" y="0.45"/>
  <xacro:rotor name="rotor_rear_right"  x="-0.45" y="-0.45"/>


  <!-- =========================
       Camera link
       ========================= -->
  <link name="drone_camera_link">

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.08"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>

  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="drone_camera_link"/>
    <origin xyz="0 0 -0.18" rpy="0 1.5708 0"/>
  </joint>


  <!-- =========================
       Gazebo camera
       ========================= -->
  <gazebo reference="drone_camera_link">

    <sensor name="drone_camera" type="camera">

      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>

      <camera>

        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>

      </camera>

      <plugin
        name="drone_camera_controller"
        filename="libgazebo_ros_camera.so">

        <ros>
          <namespace>/drone</namespace>
        </ros>

        <camera_name>camera</camera_name>
        <frame_name>drone_camera_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>

</robot>
